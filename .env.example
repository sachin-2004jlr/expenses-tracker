# ------------------------------------------------------------
# Expenses Tracker — environment variables
# Copy this file to .env and fill in what you need.
# NEVER commit .env. Secrets must stay server-side (no NEXT_PUBLIC_*).
# ------------------------------------------------------------

# --- Database -------------------------------------------------
# Production (Vercel): a PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS...).
# Local development: leave empty to use the embedded PGlite database stored in ./.data/pglite
DATABASE_URL=

# Set to "disable" if your Postgres host does not use TLS (e.g. a local docker container).
# Default: TLS is used for any non-localhost host.
DATABASE_SSL=

# Run pending Drizzle migrations automatically on first database access (default: true).
# Set to "false" if you prefer to run `npm run db:migrate` yourself.
DB_AUTO_MIGRATE=

# Where PGlite stores local data (default: ./.data/pglite). Use "memory://" for an in-memory DB.
PGLITE_DATA_DIR=

# --- AI (Ollama is the default local provider) ----------------
# ollama | openai-compatible | mock
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Leave empty to auto-select the first installed chat model (configurable in Settings → AI)
OLLAMA_MODEL=

# Optional: any OpenAI-compatible HTTP API (OpenAI, Groq, Together, LM Studio, vLLM...).
# Only used when the provider is set to "openai-compatible". Financial facts are sent to this
# endpoint, so configure it deliberately.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- App --------------------------------------------------------
# IANA time zone used to decide "today" and the current month on the server.
APP_TIMEZONE=Asia/Kolkata
