# ------------------------------------------------------------
# Expenses Tracker — environment variables
# Copy this file to .env and fill in what you need.
# NEVER commit .env. Secrets must stay server-side (no NEXT_PUBLIC_*).
# ------------------------------------------------------------

# --- Database (MongoDB) ----------------------------------------
# Any MongoDB connection string. Leave empty locally to use the MongoDB server on your machine
# (mongodb://127.0.0.1:27017/expenses_tracker). For Vercel use a free MongoDB Atlas cluster:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expenses_tracker?retryWrites=true&w=majority
# Special value "memory://" starts a throwaway in-memory MongoDB (used by the tests).
# If a mongodb+srv:// string fails with "querySrv ECONNREFUSED", your DNS blocks SRV lookups:
# use the "standard connection string" from Atlas instead (Connect → Drivers → older Node
# versions), i.e. mongodb://user:pass@host1:27017,host2:27017,host3:27017/expenses_tracker
#   ?tls=true&replicaSet=<from Atlas>&authSource=admin&retryWrites=true&w=majority
DATABASE_URL=

# --- Authentication (e-mail + password accounts) -----------------
# Secret used to sign the session cookie. REQUIRED in production; in development a built-in
# fallback is used when empty. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Optional: comma-separated list of e-mail addresses allowed to register / sign in.
# Empty = anyone who reaches the site can create an account. Recommended for a personal app.
AUTH_ALLOWED_EMAILS=
# Optional: only needed when the app runs behind a proxy without standard host headers.
# AUTH_URL=https://your-domain.com

# --- App --------------------------------------------------------
# IANA time zone used to decide "today" and the current month on the server.
APP_TIMEZONE=Asia/Kolkata
