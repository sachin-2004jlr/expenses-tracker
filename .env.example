# ------------------------------------------------------------
# Expenses Tracker — environment variables
# Copy this file to .env and fill in what you need.
# NEVER commit .env. Secrets must stay server-side (no NEXT_PUBLIC_*).
# ------------------------------------------------------------

# --- Database -------------------------------------------------
# Production (Vercel): a PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS...).
# Local development: leave empty to use the embedded PGlite database stored in ./.data/pglite
DATABASE_URL=

# Set to "disable" if your Postgres host does not use TLS (e.g. a local docker container).
# Default: TLS is used for any non-localhost host.
DATABASE_SSL=

# Run pending Drizzle migrations automatically on first database access (default: true).
# Set to "false" if you prefer to run `npm run db:migrate` yourself.
DB_AUTO_MIGRATE=

# Where PGlite stores local data (default: ./.data/pglite). Use "memory://" for an in-memory DB.
PGLITE_DATA_DIR=

# --- Authentication (Google sign-in via Auth.js) -------------------
# All three are required to enable sign-in. Leave them empty for a zero-config local
# single-user mode (used by `npm run dev` without setup, tests and CI).
#
# 1. Generate a secret:            npx auth secret     (or: openssl rand -base64 32)
# 2. Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#    Authorised redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://<your-vercel-domain>/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: comma-separated list of Google accounts allowed to sign in. Empty = any account
# (each account gets its own private data). Strongly recommended for a personal finance app.
AUTH_ALLOWED_EMAILS=
# Optional: only needed when the app runs behind a proxy without standard host headers.
# AUTH_URL=https://your-domain.com

# --- AI (Ollama is the default local provider) ----------------
# ollama | openai-compatible | mock
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Leave empty to auto-select the first installed chat model (configurable in Settings → AI)
OLLAMA_MODEL=

# Optional: any OpenAI-compatible HTTP API (OpenAI, Groq, Together, LM Studio, vLLM...).
# Only used when the provider is set to "openai-compatible". Financial facts are sent to this
# endpoint, so configure it deliberately.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- App --------------------------------------------------------
# IANA time zone used to decide "today" and the current month on the server.
APP_TIMEZONE=Asia/Kolkata
